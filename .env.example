# Banco (SQLite local por padrão; em produção use Postgres)
DATABASE_URL=sqlite:///./crosssell.db

# Pipedrive
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=innoaseguros        # https://<dominio>.pipedrive.com
PIPEDRIVE_CNPJ_FIELD=4f808fee58c9a509b20237a2ffb8b3f169293b0f
# Token de um usuário admin do Pipedrive (lê negócios e cria atividades em nome da equipe)

# Microsoft 365 (app registration com permissão de aplicativo Mail.Read + consentimento admin)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Domínios internos (e-mails destes domínios não são "clientes")
INTERNAL_DOMAINS=innoaseguros.com.br

# Claude API (temperatura dos e-mails)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Caixa que envia o link de "esqueci minha senha" (o app do Microsoft 365 precisa de Mail.Send)
EMAIL_REMETENTE=

# Em ambiente local sem HTTPS, desligue o cookie seguro
COOKIE_SEGURO=true

# LinkedIn pela Linked API, chamada direto (tokens do painel da Linked API; troque-os se forem expostos)
LINKED_API_TOKEN=
LINKED_API_IDENTIFICATION_TOKEN=
LINKEDIN_LIMITE_DIA=50
LINKEDIN_LOTE=10
LINKEDIN_VALIDADE_DIAS=180
# Consultas por dia de cada vertical (a sobra de uma passa às outras)
LINKEDIN_COTA_SAUDE=30
LINKEDIN_COTA_SAUDE_PESSOAS=20
LINKEDIN_COTA_LF=10
LINKEDIN_COTA_RE=10
# Ligar depois de testar com `crosssell linkedin-teste`
LINKEDIN_SALES_NAVIGATOR=false

# Alternativa (só se não usar a chamada direta): LinkedIn via n8n
# URL do nó Webhook do n8n (produção) e um token longo e aleatório, igual nos dois lados.
N8N_LINKEDIN_WEBHOOK_URL=
N8N_TOKEN=
# Endereço público da plataforma (o n8n devolve os resultados em /api/integracoes/linkedin/resultados)
PLATAFORMA_URL=https://crosssell.innoaseguros.com.br

# Rotina de hora em hora dentro do próprio servidor (hospedagem de um container só)
ROTINA_INTERNA=false
