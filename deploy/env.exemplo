# Copie para deploy/.env e preencha. Este arquivo NUNCA vai para o GitHub.

# Banco (Postgres no Docker, ao lado da plataforma). Senha longa e aleatória: openssl rand -hex 24
POSTGRES_PASSWORD=
# Porta da plataforma só para o Nginx do servidor (127.0.0.1); a 3333 é da API do Zeca
PORTA_LOCAL=8000
# Cópias diárias do banco (últimos 7 dias), no disco do servidor
PASTA_BACKUP=/opt/crosssell-backups
COOKIE_SEGURO=true

# Pipedrive (token de API de um usuário admin) e Linked API
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=innoaseguros
LINKED_API_TOKEN=
LINKED_API_IDENTIFICATION_TOKEN=
LINKEDIN_LIMITE_DIA=50

# Microsoft 365 (app registration com Mail.Read e Mail.Send de aplicativo)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
EMAIL_REMETENTE=oi@innoaseguros.com.br
INTERNAL_DOMAINS=innoaseguros.com.br

# Claude API (temperatura dos e-mails)
ANTHROPIC_API_KEY=
# Modelo padrão (claude-sonnet-5-5 ou claude-opus-5-5). O master pode trocar na tela Equipe, e a escolha de lá vale sobre este.
ANTHROPIC_MODEL=claude-sonnet-5-5
